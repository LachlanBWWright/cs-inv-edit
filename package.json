{
  "name": "cs-inv-edit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run build:backend && npm run dev -w @cs-inv-edit/desktop",
    "dev:web": "npm run dev -w @cs-inv-edit/web",
    "build": "npm run build -ws --if-present && npm run build:backend",
    "build:backend": "go build -o bin/cs2-backend ./backend/cmd/cs2-backend",
    "build:repo": "./scripts/build.sh",
    "test:backend": "go test ./backend/...",
    "test:frontend": "vitest run",
    "test": "./scripts/test.sh",
    "lint": "eslint .",
    "run": "./scripts/run.sh",
    "check": "npm run lint && npm run build && npm run test",
    "test-backend": "./bin/cs2-backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "eslint-plugin-neverthrow": "^1.1.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
