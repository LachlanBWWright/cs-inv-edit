{
  "name": "cs-inv-edit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "build:web": "vite build",
    "build:electron": "tsup --config tsup.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src electron vite.config.ts tsup.config.ts capacitor.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "desktop:watch": "tsup --config tsup.config.ts --watch",
    "desktop:launch": "wait-on tcp:127.0.0.1:5173 file:dist-electron/main.cjs && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.cjs",
    "desktop:dev": "concurrently -k \"npm run dev\" \"npm run desktop:watch\" \"npm run desktop:launch\"",
    "desktop:start": "npm run build && electron dist-electron/main.cjs",
    "mobile:sync": "npm run build:web && cap sync",
    "mobile:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.1",
    "@capacitor/core": "8.4.1",
    "neverthrow": "8.2.0",
    "solid-js": "1.9.13"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.1",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.1",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@types/node": "26.0.0",
    "concurrently": "10.0.3",
    "electron": "42.4.1",
    "eslint": "8.57.1",
    "eslint-plugin-neverthrow": "1.1.4",
    "eslint-plugin-solid": "0.14.5",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.9",
    "wait-on": "9.0.10"
  }
}
