{
  "name": "@cs-inv-edit/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A desktop client for managing Counter-Strike 2 and Team Fortress 2 inventories.",
  "homepage": "https://github.com/LachlanBWWright/cs-inv-edit",
  "author": {
    "name": "CS Inventory Edit",
    "email": "noreply@github.com"
  },
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "pnpm build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "pnpm build:electron && vite build",
    "build:electron": "tsup --config tsup.config.ts",
    "package:linux": "pnpm build && electron-builder --linux AppImage deb --publish never",
    "package:mac": "pnpm build && electron-builder --mac dmg zip --publish never",
    "package:win": "pnpm build && electron-builder --win nsis zip --publish never",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@cs-inv-edit/app": "workspace:*",
    "@cs-inv-edit/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "neverthrow": "^8.2.0",
    "solid-js": "^1.9.10",
    "tailwindcss": "^4.3.1",
    "vite": "^7.2.7",
    "vite-plugin-solid": "^2.11.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "tsup": "^8.5.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.lachlanbwwright.csinvedit",
    "productName": "CS Inventory Edit",
    "executableName": "cs-inv-edit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../bin",
        "to": "bin",
        "filter": [
          "cs2-backend*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
